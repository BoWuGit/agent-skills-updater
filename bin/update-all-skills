#!/usr/bin/env bash
set -uo pipefail

config_file="${AGENT_SKILLS_CONFIG:-$HOME/.config/agent-skills-updater/config}"
if [[ -f "$config_file" ]]; then
  # This is an explicit local shell configuration owned by the current user.
  # shellcheck source=/dev/null
  source "$config_file"
fi

usage() {
  cat <<'EOF'
Usage: update-all-skills [--dry-run]

Install or update this pack's complete skill set in every detected harness:
  - thermo-nuclear-code-quality-review
  - sim-use
  - OpenClaw autoreview
  - all non-deprecated Matt Pocock skills
  - Anthropic's official code-simplifier

Exit statuses:
  0  Every updater succeeded.
  1  At least one updater failed.
EOF
}

dry_run=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      dry_run=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'Unknown option: %s\n\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd "$(dirname "$script_path")" && pwd)"
  link_target="$(readlink "$script_path")"
  if [[ "$link_target" == /* ]]; then
    script_path="$link_target"
  else
    script_path="$script_dir/$link_target"
  fi
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
root_dir="$(cd "$script_dir/.." && pwd)"
updaters_dir="$root_dir/updaters"

labels=()
results=()
failed=0

run_update() {
  local label="$1"
  local status
  shift

  printf '\n==> %s\n' "$label"
  if [[ "$dry_run" -eq 1 ]]; then
    printf '    '
    printf '%q ' "$@"
    printf '\n'
    labels+=("$label")
    results+=("DRY RUN")
    return
  fi

  if "$@"; then
    status=0
  else
    status=$?
  fi

  labels+=("$label")
  if [[ "$status" -eq 0 ]]; then
    results+=("OK")
  else
    results+=("FAILED (exit $status)")
    failed=$((failed + 1))
  fi
}

run_update \
  "thermo-nuclear-code-quality-review" \
  "$updaters_dir/update-thermo-nuclear-code-quality-review"

run_update \
  "sim-use" \
  "$updaters_dir/update-sim-use"

run_update \
  "OpenClaw agent skills (autoreview)" \
  "$updaters_dir/update-openclaw-agent-skills"

run_update \
  "Matt Pocock skills" \
  "$updaters_dir/update-mattpocock-skills"

run_update \
  "code-simplifier (official)" \
  "$updaters_dir/update-code-simplifier"

printf '\nSummary\n'
for ((i = 0; i < ${#labels[@]}; i++)); do
  printf '  %-42s %s\n' "${labels[$i]}" "${results[$i]}"
done

if [[ "$failed" -gt 0 ]]; then
  printf '\n%d updater(s) failed.\n' "$failed" >&2
  exit 1
fi

if [[ "$dry_run" -eq 1 ]]; then
  printf '\nDry run completed; no updater was executed.\n'
else
  printf '\nAll skills updated successfully. Restart or reload agent harnesses as needed.\n'
fi
