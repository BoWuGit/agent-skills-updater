#!/usr/bin/env bash
# Compatibility entry point retained for links to the original example.
#
# The production runner now ships in bin/update-all-skills and installs:
#   - thermo-nuclear-code-quality-review
#   - sim-use
#   - OpenClaw autoreview
#   - every non-deprecated Matt Pocock skill
#   - Anthropic's official code-simplifier
#
# It runs every updater even after a failure and reserves exit status 2 for
# upstream changes that require human review.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec "$repo_root/bin/update-all-skills" "$@"
